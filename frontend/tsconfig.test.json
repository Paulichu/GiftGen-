{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "outDir": "test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["test/**/*.ts"],
  "exclude": ["node_modules", ".next", "test-dist"]
}

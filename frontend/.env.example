# Hostinger SMTP — used when you approve an offer email in the studio.
# SMTP_PASS is the mailbox password from Hostinger (hPanel → Emails → mailbox → Password).
# Never commit the real value; keep it in .env, not in .env.example.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ip@ojjja.site
SMTP_PASS=

# Required for offer emails. Signs one-time approval tokens; at least 16 chars.
# Generate once with `openssl rand -hex 32` and keep it stable across restarts.
OFFER_EMAIL_SECRET=

# Required for every approve and send request. Callers must send it in the
# `x-offer-approval` header; there is no loopback exemption, because proxy
# headers can be forged.
OFFER_APPROVAL_PASSWORD=

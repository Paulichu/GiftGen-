# Hostinger SMTP — used when you approve an offer email in the studio.
# SMTP_PASS is the mailbox password from Hostinger (hPanel → Emails → mailbox → Password).
# Never commit the real value; keep it in .env, not in .env.example.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ip@ojjja.site
SMTP_PASS=

# Signs one-time approval tokens for offer emails. Generate once, e.g.
# `openssl rand -hex 32`, and keep it stable across restarts (optional: without it
# the studio uses a per-process secret, so pending approvals expire on restart).
OFFER_EMAIL_SECRET=

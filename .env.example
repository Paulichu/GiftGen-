# Emergent Studio needs no API keys and no database.
#
# Builds, versions and messages are stored in .data/studio.json
# (frontend/.data/studio.json when running locally from frontend/).
# Data created by the generated apps lives in each visitor's browser
# (localStorage), not on the server.
#
# Optional — only needed when the server does not run on port 3000.
# PORT=3000
